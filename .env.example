# Public origin used for links, metadata, and callbacks. Set to your deployed HTTPS URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project values. Keep the service role key server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Inference: mock (no transformation), local (your worker), or remote (external GPU worker).
INFERENCE_MODE=mock
LOCAL_INFERENCE_API_URL=http://127.0.0.1:8000
INFERENCE_API_URL=
INFERENCE_API_KEY=
OUTPUT_TOKEN_SECRET=

# Optional product integrations; self-hosted defaults are privacy-conscious and billing-free.
BILLING_ENABLED=false
BILLING_SECRET_KEY=
BILLING_WEBHOOK_SECRET=
ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Optional public links/contact details.
NEXT_PUBLIC_ABUSE_EMAIL=abuse@example.com
NEXT_PUBLIC_GITHUB_URL=
